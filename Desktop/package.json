{
  "name": "anvil-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Anvil \u2014 cross-platform desktop UI (Electron + React)",
  "main": "out/main/index.js",
  "author": "Anvil",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:web": "vite build -c vite.web.config.ts && vite preview -c vite.web.config.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
