{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "baseUrl": ".", "paths": { "@/*": ["src/renderer/src/*"] }, "types": ["vite/client"]
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "tests/**/*"],
  "exclude": ["tests/launch.test.ts", "tests/bundle-runtime.test.ts"]
}
